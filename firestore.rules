rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════
    // 역할 판별
    //  - 관리자: admins/{uid} 문서가 있는 로그인 계정 (센터 공용 계정 1개)
    //  - 기업  : companyAccounts/{uid} 문서가 있는 로그인 계정 (기업별 1개)
    //
    // ⚠️ 예전에는 "로그인만 하면 관리자"였다. 기업 계정이 생기면
    //    기업이 전체 회원정보·면담일지까지 보게 되므로 반드시 분리해야 한다.
    //
    // 복구 방법: admins 문서가 지워지면 앱에서 다시 만들 수 없다(규칙이 막음).
    //           그때는 Firebase 콘솔 → Firestore → admins 에서 직접 생성.
    //           문서 ID = Authentication 의 사용자 UID
    // ═══════════════════════════════════════════
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // 기업 계정: companyAccounts 문서가 있고 active가 꺼져 있지 않은 로그인 계정
    function isCompany() {
      return request.auth != null
        && exists(/databases/$(database)/documents/companyAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/companyAccounts/$(request.auth.uid)).data.active != false;
    }
    // 이 기업 계정이 소속된 기업 ID
    function myCompanyId() {
      return get(/databases/$(database)/documents/companyAccounts/$(request.auth.uid)).data.companyId;
    }

    // ── 역할 등록부 ──
    // 관리자만 열람·발급. 본인 계정 정보는 로그인 후 스스로 읽을 수 있어야 함.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
    match /companyAccounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── 회원 정보 (민감: 이름·전화번호) ──
    // get(개별 조회)·가입·본인 정보 수정: 공개 (deviceId를 아는 본인만 실질 접근)
    // list(전체 목록)·삭제: 관리자만 → 전화번호 대량 유출 차단
    // 🔒 2단계: 문서 ID와 deviceId 필드가 일치해야만 쓰기 허용
    //          → 남의 회원 문서를 임의로 만들거나 덮어쓰는 위조 차단
    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        || request.resource.data.deviceId == userId;
      allow delete: if isAdmin();
    }

    // ── 상담 신청 (민감) ──
    // 사용자가 자기 상담을 deviceId 필터로 조회하는 구조라 read 개방 유지
    // 🔒 2단계: 일반 사용자는 comments(문의 대화) 추가만 가능
    //          → 상담 내용·상태·이름 등 기존 기록 변조/훼손 차단
    match /consulting/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']);
      allow delete: if isAdmin();
    }

    // ── 신청서 (민감: 이름·주소·학교) ──
    // 문서 ID = deviceId. 본인 제출·수정 가능, 전체 목록은 관리자만
    // 🔒 2단계: 문서 ID와 deviceId 필드 일치 검증
    match /applications/{deviceId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        || request.resource.data.deviceId == deviceId;
      allow delete: if isAdmin();
    }

    // ── 익명 의견함 ──
    // 제출만 공개, 열람·삭제는 관리자만
    match /feedback/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── 면담일지 (매우 민감: 심리·개인 사정 포함) ──
    // 로그인한 센터 담당자만 읽고 쓸 수 있음. 학생 앱에서는 접근 불가.
    match /counseling/{id} {
      allow read, write: if isAdmin();
    }

    // ── 학습근로자 명단 ──
    // 기업 계정은 자기 소속 학습근로자만 조회 가능 (읽기 전용)
    // ⚠️ 목록 조회 시 반드시 where('companyId','==',내기업) 으로 질의해야 통과한다
    match /workers/{id} {
      allow read: if isAdmin() || (isCompany() && resource.data.companyId == myCompanyId());
      allow write: if isAdmin();
    }

    // ── 훈련과정 (기업 ↔ 학년/직종 연결) ──
    // 기업 계정은 자기 기업의 과정만 조회 가능 (읽기 전용)
    match /courses/{id} {
      allow read: if isAdmin() || (isCompany() && resource.data.companyId == myCompanyId());
      allow write: if isAdmin();
    }

    // ── 기업현장교사 의견서 (학습근로자별·월별) ──
    // 기업 계정: 자기 기업 것만 읽고 쓸 수 있다.
    // 🔒 잠금 원칙: 서명 후 locked=true 가 되면 기업은 더 이상 수정할 수 없다.
    //    되돌리려면 관리자가 잠금을 해제해야 한다(증빙 무결성).
    // ⚠️ 기업이 목록을 조회할 때는 반드시 where('companyId','==',내기업) 으로 질의해야 통과한다.
    match /teacherOpinions/{id} {
      allow read: if isAdmin()
        || (isCompany() && resource.data.companyId == myCompanyId());
      allow create: if isAdmin()
        || (isCompany() && request.resource.data.companyId == myCompanyId());
      // 기업 수정: 잠기지 않았을 때만, 그리고 소속 기업을 바꿔치기할 수 없다
      allow update: if isAdmin()
        || (isCompany()
            && resource.data.companyId == myCompanyId()
            && request.resource.data.companyId == resource.data.companyId
            && resource.data.locked != true);
      allow delete: if isAdmin();
    }

    // ── 월별 체크리스트 (훈련과정별·월별) ──
    // 의견서와 같은 원칙: 자기 기업 것만, 서명 제출(locked) 후에는 관리자만 손댈 수 있다.
    match /checklists/{id} {
      allow read: if isAdmin()
        || (isCompany() && resource.data.companyId == myCompanyId());
      allow create: if isAdmin()
        || (isCompany() && request.resource.data.companyId == myCompanyId());
      allow update: if isAdmin()
        || (isCompany()
            && resource.data.companyId == myCompanyId()
            && request.resource.data.companyId == resource.data.companyId
            && resource.data.locked != true);
      allow delete: if isAdmin();
    }

    // ── 기업에 보낸 알림 기록 ──
    // 푸시는 글자가 잘리므로 기업 페이지에서 전문을 다시 볼 수 있게 남긴다.
    // 기업은 자기 앞으로 온 것만 읽고, 보내는 건 센터만 한다.
    match /firmNotifications/{id} {
      allow read: if isAdmin()
        || (isCompany() && resource.data.companyId == myCompanyId());
      allow write: if isAdmin();
    }

    // ── 학습근로자 면담일지 (OJT · 학습근로자별 · 월 1회 이상) ──
    // 기업은 월 1회 이상, 공동훈련센터는 분기 1회 이상 작성한다.
    // writer 필드로 작성 주체를 구분한다 ('company' | 'center').
    // 🔒 서명 후에는 관리자만 손댈 수 있다.
    match /ojtCounseling/{id} {
      allow read: if isAdmin()
        || (isCompany() && resource.data.companyId == myCompanyId());
      allow create: if isAdmin()
        || (isCompany() && request.resource.data.companyId == myCompanyId()
            && request.resource.data.writer == 'company');
      allow update: if isAdmin()
        || (isCompany()
            && resource.data.companyId == myCompanyId()
            && resource.data.writer == 'company'
            && request.resource.data.companyId == resource.data.companyId
            && resource.data.status != 'confirmed');
      allow delete: if isAdmin();
    }

    // ── 내부평가지 (훈련과정별·월별 · 파일 왕복) ──
    // 실제 파일은 Storage에 있고, 여기에는 상태와 파일 목록(꼬리표)만 둔다.
    // 상태: waiting(대기) → sheetReady(평가지등록) → submitted(완료본제출) → confirmed(확인)
    // 기업은 센터가 확인을 마치기 전까지만 수정할 수 있다.
    match /assessments/{id} {
      allow read: if isAdmin()
        || (isCompany() && resource.data.companyId == myCompanyId());
      allow create: if isAdmin()
        || (isCompany() && request.resource.data.companyId == myCompanyId());
      allow update: if isAdmin()
        || (isCompany()
            && resource.data.companyId == myCompanyId()
            && request.resource.data.companyId == resource.data.companyId
            && resource.data.status != 'confirmed');
      allow delete: if isAdmin();
    }

    // ── 중도탈락 관리 (민감: 탈락 사유·개선조치) ──
    // 로그인한 담당자만 접근. 학생 앱에서는 열 수 없음.
    match /dropouts/{id} {
      allow read, write: if isAdmin();
    }

    // ── 관리자 활동 로그 ──
    match /audit_logs/{id} {
      allow read, write: if isAdmin();
    }

    // ── 앱 설정 (관리자 알림 대상, 화면 안내문구 등) ──
    // 신청·상담 화면이 admin_targets를 읽어 관리자에게 푸시를 보내므로 get은 공개.
    // 수정은 관리자만 → 알림 대상 바꿔치기 차단.
    //
    // 예외: notify_log 한 문서만 쓰기를 연다.
    //   로그인하지 않은 학생 화면에서 "알림이 실제로 전달됐는지"를 남겨야
    //   관리자가 조용한 실패를 알아챌 수 있다.
    //   덮어쓰기만 가능한 단일 문서라 피해 범위가 없고,
    //   last 필드 하나만 건드리도록 제한한다.
    match /app_config/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin()
        || (id == 'notify_log'
            && request.resource.data.keys().hasOnly(['last']));
    }

    // ── 예약 발송 ──
    match /scheduled_notifications/{id} {
      allow read, write: if isAdmin();
    }

    // ── 공지사항: 읽기 공개, 등록·삭제는 관리자만 ──
    // 사용자 상호작용(댓글·이모지·조회수) 필드만 일반 수정 허용
    match /notices/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['comments', 'reactions', 'views', 'viewCount', 'readBy']);
    }

    // ── 자료실: 읽기 공개, 관리는 관리자만 ──
    match /library/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 취업 정보 ──
    match /jobs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 일정 캘린더 ──
    // 일정 본문은 관리자만 등록/수정, 댓글(하위 컬렉션)은 사용자도 작성 가능
    // ⚠️ 하위 컬렉션은 상위 match에 포함되지 않으므로 반드시 따로 선언해야 함
    match /calendar_events/{id} {
      allow read: if true;
      allow write: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }

    // ── 시험 일정 (중간·기말·외부평가·학습활동서) ──
    // 학과 구분 없이 전체 공개, 등록·수정은 관리자만
    match /exam_schedules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 학습기업 디렉토리 ──
    match /companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 만족도 조사 설정 ──
    match /surveyConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 알림 기록 (종 위젯 표시용) ──
    match /notifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 그 외 모든 컬렉션: 관리자만 (기본 잠금) ──
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
